# StudyOS — Environment Template
# Copy to .env and fill in values. Never commit .env to version control.

# ── Public (exposed to browser) ──────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Private (server-only, never exposed) ─────────────────────────────────────
# JWT_SECRET must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Supabase service role key (bypasses RLS — keep secret!)
SUPABASE_SERVICE_ROLE_KEY=

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://studyos:studyos@localhost:5432/studyos

# Redis URL (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Sentry (error monitoring)
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
