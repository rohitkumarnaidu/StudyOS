# Copy to `.env` — do not commit `.env`. Every `STUDYOS_*` key is listed below (active lines).
# Production: STUDYOS_APP_ENV=production, strong STUDYOS_JWT_SECRET, STUDYOS_ALLOW_LEGACY_DEMO_BEARER=false,
#             STUDYOS_TRUSTED_HOSTS set, STUDYOS_DATABASE_URL with TLS (e.g. Supabase pooler + sslmode=require).

# --- Runtime ---
STUDYOS_APP_ENV=development
STUDYOS_LOG_LEVEL=INFO

# --- HTTP / edge ---
STUDYOS_CORS_ORIGINS=http://localhost:3000
STUDYOS_RATE_LIMIT_DEFAULT=120/minute
STUDYOS_TRUSTED_HOSTS=
STUDYOS_EXPOSE_ERROR_DETAIL=false

# --- PostgreSQL (empty = in-memory demo auth; else asyncpg pool, e.g. Supabase local 54322) ---
STUDYOS_DATABASE_URL=

# --- JWT / sessions (must match Next.js STUDYOS_JWT_SECRET and issuer) ---
STUDYOS_JWT_SECRET=PLACEHOLDER_REPLACE_WITH_SECRET_MIN_32_CHARS________
STUDYOS_JWT_ISSUER=studyos-api
STUDYOS_JWT_ALGORITHM=HS256
STUDYOS_ACCESS_TOKEN_TTL_SECONDS=900
STUDYOS_REFRESH_TOKEN_TTL_SECONDS=604800
STUDYOS_ALLOW_LEGACY_DEMO_BEARER=true
STUDYOS_DEMO_LOGIN_EMAIL=demo@studyos.app

# --- AI / LLM (empty API keys = provider skipped unless primary is set) ---
STUDYOS_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
STUDYOS_AI_OPENAI_API_KEY=
STUDYOS_AI_OPENAI_BASE_URL=https://api.openai.com/v1
STUDYOS_AI_ANTHROPIC_API_KEY=
STUDYOS_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
STUDYOS_AI_PRIMARY_PROVIDER=ollama
STUDYOS_AI_FALLBACK_CHAIN=
STUDYOS_AI_DEFAULT_MODEL_OLLAMA=llama3.2
STUDYOS_AI_DEFAULT_MODEL_OPENAI=gpt-4o-mini
STUDYOS_AI_DEFAULT_MODEL_ANTHROPIC=claude-3-5-haiku-20241022
STUDYOS_AI_MAX_RETRIES=2
STUDYOS_AI_RETRY_BASE_SECONDS=0.5
STUDYOS_AI_MEMORY_MAX_MESSAGES=40
STUDYOS_AI_MEMORY_SESSION_TTL_SECONDS=3600
STUDYOS_AI_WARM_ON_START=false
STUDYOS_AI_MCP_SERVERS_JSON=[]
